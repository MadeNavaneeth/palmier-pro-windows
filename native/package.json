{
  "name": "palmier-compositor",
  "version": "0.1.0",
  "description": "GPU-accelerated compositor native addon for Palmier Pro Windows",
  "main": "index.node",
  "scripts": {
    "build": "napi build --release && node ../scripts/native-addon.mjs",
    "build:debug": "napi build && node ../scripts/native-addon.mjs",
    "artifacts": "napi artifacts",
    "check": "node ../scripts/native-addon.mjs --check"
  },
  "napi": {
    "binaryName": "palmier-compositor",
    "triples": {
      "defaults": true
    }
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0-alpha.86"
  }
}
